# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=users_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=users_db

# Servidor
PORT=8081
# production | development
NODE_ENV=development

# Orígenes del frontend autorizados (separados por coma). Obligatorio en producción.
# Ejemplo: CORS_ORIGINS=http://localhost,http://mi-servidor.cl
CORS_ORIGINS=

# Clave para las rutas administrativas (listar, consultar y eliminar usuarios).
# Se envía en la cabecera X-API-Key. Sin ella, esas rutas quedan deshabilitadas.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Opcional: crea el usuario inicial "admin" con esta contraseña si la tabla está vacía.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com

# Opcional: límites de peticiones por IP
REGISTER_RATE_LIMIT=10
API_RATE_LIMIT=120
# Opcional: número de proxies inversos de confianza delante del servicio (ej. 1)
TRUST_PROXY=
